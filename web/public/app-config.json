{
  "app": {
    "title": "3d-printing - create and adjust models with GH-Copilot",
    "tagline": "Modelle im Browser ansehen und per GitHub Copilot in einer GitHub-Action erzeugen oder anpassen."
  },
  "repository": {
    "owner": "harrybin",
    "repo": "3d-printing",
    "defaultBranch": "main",
    "visibility": "public"
  },
  "workflow": {
    "file": "copilot-agent.yml",
    "name": "Copilot model agent"
  },
  "auth": {
    "mode": "personal-access-token",
    "tokenStorage": "sessionStorage",
    "requiredPermissions": ["Metadata: Read", "Actions: Read and write"]
  },
  "prompt": {
    "chunkSize": 1024,
    "maxChunks": 12
  },
  "images": {
    "storage": "indexeddb",
    "maxFiles": 24
  }
}
